#!/usr/bin/env bash
# Starts the SonicCore app once: a second launch (menu while the autostarted
# copy sits in the tray) would add a second tray icon, so it does nothing.
# `--tray` starts with only the tray icon, as at login.
set -euo pipefail

readonly APP_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly MAIN="$APP_DIR/main.qml"

if pgrep -u "$(id -u)" -f -- "$MAIN" >/dev/null 2>&1; then
    exit 0
fi

QML="$(command -v qml6 || command -v qml || true)"
[[ -n "$QML" ]] || { printf 'erro: qml6 (Qt Declarative) não encontrado\n' >&2; exit 1; }

# The effects read the colors the OpenRGB plugin publishes in a local file.
export QML_XHR_ALLOW_FILE_READ=1

# The qml6 runtime would give the window Qt's own logo; use the app icon.
ICON_ARGS=()
ICON="$APP_DIR/jambalinux-soniccore.svg"
[[ -f "$ICON" ]] && ICON_ARGS=(--qwindowicon "$ICON")

if [[ "${1:-}" == "--tray" ]]; then
    exec "$QML" "${ICON_ARGS[@]}" --transparent --apptype widget "$MAIN" -- --tray
fi
# --transparent gives the window an alpha channel for the see-through background.
exec "$QML" "${ICON_ARGS[@]}" --transparent --apptype widget "$MAIN"
